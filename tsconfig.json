{
    "compilerOptions": {
        "strict": true,
        "target": "ES2022",
        "lib": [ "ES2022", "DOM", "DOM.Iterable" ],
        "module": "ESNext",
        "moduleResolution": "bundler",
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "sourceMap": false,
        "rootDir": "src",
        "outDir": "dist/js",
        "noEmitOnError": true,
        "jsx": "react-jsx"
    },
    "include": [ "src" ]
}
